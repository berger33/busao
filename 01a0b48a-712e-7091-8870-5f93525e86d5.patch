+def luma(c):
+    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
+
+
+def chroma(c):
+    mx, mn = max(c), min(c)
+    return 0.0 if mx <= 1e-6 else (mx - mn) / mx
