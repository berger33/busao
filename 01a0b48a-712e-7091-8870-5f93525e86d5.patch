+        d.rectangle([zx, y_lat - 26, zx + comprimento * escala2, y_lat - 6], fill=cor_calcada)
+        d.rectangle([zx, y_lat - 6, zx + comprimento * escala2, y_lat + 10], fill=cor_pista)
