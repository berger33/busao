+    d.text((px + 12, py2 - 26), "Planta (2 quarteiroes de 28 m): lajes, lotes, arvores e postes",
+           font=f_sub, fill=(230, 226, 218))
+    escala2 = (pw - 60) / (comprimento * 2 + 4)
+    x_planta = px + 30
+    for q in range(2):
